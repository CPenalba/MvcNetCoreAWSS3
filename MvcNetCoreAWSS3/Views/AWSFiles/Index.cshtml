@model List<string>

@{
	var bucketUrl = configuration["AWS:BucketURL"];
}

<h1>AWS Storage S3</h1>

<p>
	<a asp-controller="AWSFiles" asp-action="UploadFile" class="btn btn-primary">
		Upload File AWS
	</a>
</p>

@if (Model != null)
{
	<ul class="list-group">
		@foreach (string name in Model)
		{
			<li class="list-group-item">
				@name
				@{
					string url = bucketUrl + name;
				}
				<img src="@url" style="width:120px; height:120px" />
				<a asp-controller="AWSFiles" asp-action="PrivateFile"
				   asp-route-filename="@name" class="btn btn-warning">
					Private File
				</a>
				<a asp-controller="AWSFiles" asp-action="DeleteFile"
				   asp-route-filename="@name" class="btn btn-danger">
					Delete
				</a>
			</li>
		}
	</ul>
}
